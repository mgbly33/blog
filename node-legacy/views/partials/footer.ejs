<% if (user) { %>
    <!-- 通知系统 -->
    <script>
        // 更新未读通知数量
        function updateUnreadCount() {
            fetch('/api/notifications/unread-count')
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        const count = data.count;
                        const badge = document.getElementById('unread-count');
                        const menuBadge = document.getElementById('unread-count-menu');

                        if (count > 0) {
                            badge.textContent = count > 99 ? '99+' : count;
                            badge.style.display = 'inline';
                            if (menuBadge) {
                                menuBadge.textContent = count;
                                menuBadge.style.display = 'inline';
                            }
                        } else {
                            badge.style.display = 'none';
                            if (menuBadge) {
                                menuBadge.style.display = 'none';
                            }
                        }
                    }
                })
                .catch(err => console.error('获取未读通知失败:', err));
        }

        // 页面加载时更新
        updateUnreadCount();

        // 每30秒更新一次
        setInterval(updateUnreadCount, 30000);
    </script>
    <% } %>

        <!-- 搜索建议 -->
        <script>
            $(document).ready(function () {
                let searchTimer;
                const searchInput = $('#search-input');
                const suggestions = $('#search-suggestions');

                searchInput.on('input', function () {
                    clearTimeout(searchTimer);
                    const query = $(this).val().trim();

                    if (query.length >= 2) {
                        searchTimer = setTimeout(function () {
                            $.get(`/api/search/suggestions?q=${encodeURIComponent(query)}`, function (data) {
                                if (data.success && data.suggestions.length > 0) {
                                    let html = '<ul class="list-group">';
                                    data.suggestions.forEach(function (title) {
                                        html += `<li class="list-group-item list-group-item-action suggestion-item" style="cursor: pointer;">${title}</li>`;
                                    });
                                    html += '</ul>';
                                    suggestions.html(html).show();

                                    // 点击建议项进行搜索
                                    $('.suggestion-item').on('click', function () {
                                        const selectedTitle = $(this).text();
                                        searchInput.val(selectedTitle);
                                        searchInput.closest('form').submit();
                                    });
                                } else {
                                    suggestions.hide();
                                }
                            });
                        }, 300);
                    } else {
                        suggestions.hide();
                    }
                });

                // 点击其他地方隐藏建议
                $(document).on('click', function (e) {
                    if (!$(e.target).closest('.search-form').length) {
                        suggestions.hide();
                    }
                });
            });
        </script>
        </body>


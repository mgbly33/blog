<%- include('partials/header') %>

    <div class="container animate__animated animate__fadeIn">
        <!-- 2.0 艺术化 Hero 区域 -->
        <header class="hero-elegant mb-5">
            <h1 class="display-1 title-decoration">听见思想的声音</h1>
            <p class="lead mt-3 mx-auto" style="max-width: 800px;">
                探索技术与人文的交汇点，在这里，每一篇文字都值得被优雅地阅读。
            </p>
            <div class="d-flex justify-content-center gap-4 mt-5">
                <a href="/blog/new" class="btn btn-primary px-5 py-3">
                    <i class="fa-solid fa-pen-nib me-2"></i>开始创作
                </a>
                <a href="#content" class="btn btn-outline-primary px-5 py-3">
                    <i class="fa-solid fa-compass me-2"></i>探索文章
                </a>
            </div>
        </header>

        <div class="row g-5" id="content">
            <!-- 左侧内容：艺术化博客流 -->
            <div class="col-lg-8">
                <!-- 过滤器 -->
                <div class="d-flex justify-content-between align-items-center mb-4 pb-3 border-bottom">
                    <% var sort=typeof currentSort !=='undefined' ? currentSort : 'recommend' ; %>
                        <nav class="nav nav-pills">
                            <a class="nav-link <%= sort === 'recommend' ? 'active' : '' %>"
                                href="/?sort=recommend">精选推荐</a>
                            <a class="nav-link <%= sort === 'latest' ? 'active' : '' %>" href="/?sort=latest">最新发布</a>
                            <a class="nav-link <%= sort === 'hot' ? 'active' : '' %>" href="/?sort=hot">全站热门</a>
                        </nav>
                </div>

                <% if (blogs.length> 0) { %>
                    <div class="blog-stream-2">
                        <% blogs.forEach((blog, index)=> { %>
                            <article class="blog-post-card-2 fade-in"
                                style="animation-delay: <%= (index * 0.15).toFixed(2) %>s;">
                                <div class="post-image-box">
                                    <% if (blog.image) { %>
                                        <img src="<%= blog.image %>" alt="<%= blog.title %>" loading="lazy">
                                        <% } else { %>
                                            <div
                                                style="height: 260px; background: linear-gradient(135deg, #F8F5F2, #E8B4B8); display: flex; align-items: center; justify-content: center; padding-bottom: 80px; box-sizing: border-box;">
                                                <i class="fa-solid fa-feather-pointed fa-4x opacity-20"></i>
                                            </div>
                                            <% } %>

                                                <% if (blog.isSticky && sort==='recommend' ) { %>
                                                    <div class="position-absolute top-0 start-0 m-4">
                                                        <span class="badge bg-primary shadow-sm px-3 py-2">
                                                            <i class="fa-solid fa-thumbtack me-1"></i> 置顶文章
                                                        </span>
                                                    </div>
                                                    <% } %>
                                </div>

                                <div class="post-content-box">
                                    <header
                                        class="blog-meta mb-3 d-flex align-items-center gap-4 text-secondary opacity-75 small">
                                        <span>
                                            <i class="fa-regular fa-calendar-check me-1"></i>
                                            <%= blog.createdAt ? blog.createdAt.toLocaleDateString('zh-CN', {
                                                year: 'numeric' , month: 'long' , day: 'numeric' }) : '未知日期' %>
                                        </span>
                                        <% if (blog.author) { %>
                                            <span>
                                                <i class="fa-solid fa-user-pen me-1"></i>
                                                <%= blog.author.username %>
                                            </span>
                                            <% } %>
                                    </header>

                                    <h2 class="blog-post-title mb-4">
                                        <a href="/blog/<%= blog._id %>">
                                            <%= blog.title %>
                                        </a>
                                    </h2>

                                    <p class="mb-5 lh-lg text-muted opacity-90" style="font-size: 1.05rem;">
                                        <%= blog.content.replace(/<[^>]*>/g, '').substring(0, 160) %>...
                                    </p>

                                    <footer
                                        class="d-flex align-items-center justify-content-between pt-4 border-top mt-auto">
                                        <div class="d-flex gap-4">
                                            <span class="small text-muted"><i class="fa-regular fa-eye me-1"></i>
                                                <%= blog.views %>
                                            </span>
                                            <span class="small text-muted"><i class="fa-regular fa-heart me-1"></i>
                                                <%= blog.likes ? blog.likes.length : 0 %>
                                            </span>
                                        </div>
                                        <a href="/blog/<%= blog._id %>" class="btn-read-more text-primary fw-bold">
                                            阅读全文 <i class="fa-solid fa-arrow-right-long ms-2"></i>
                                        </a>
                                    </footer>
                                </div>
                            </article>
                            <% }) %>
                    </div>

                    <!-- Pagination -->
                    <div class="mt-5 d-flex justify-content-center">
                        <%- include('partials/pagination', { totalPages: totalPages, currentPage: currentPage, sort:
                            sort, query: query, currentCategory: currentCategory }) %>
                    </div>
                    <% } else { %>
                        <div class="text-center py-5 glass-clay">
                            <img src="https://gw.alipayobjects.com/zos/antfincdn/ZHrcdLPrvN/empty.svg" alt="No Data"
                                width="160" class="mb-4" loading="lazy">
                            <h3 class="font-serif">暂无文字墨迹</h3>
                            <p class="text-muted">等待着一个灵魂，在此写下第一行思绪...</p>
                            <a href="/blog/new" class="btn btn-primary mt-4 px-5">立即启程</a>
                        </div>
                        <% } %>
            </div>

            <!-- 右侧边栏：极简艺术风格 -->
            <div class="col-lg-4">
                <!-- 用户卡片 -->
                <% if (user) { %>
                    <div class="glass-clay p-4 mb-5 text-center mt-lg-5">
                        <div class="mb-4">
                            <img src="<%= user.avatar || 'https://ui-avatars.com/api/?name=' + user.username + '&background=random' %>"
                                class="rounded-circle shadow-sm border border-4 border-white" width="100" height="100">
                        </div>
                        <h4 class="mb-1">
                            <%= user.username %>
                        </h4>
                        <p class="text-muted small mb-4 px-3">
                            <%= user.bio || '在这个喧嚣的世界，寻找一丝宁静。' %>
                        </p>
                        <div class="d-flex justify-content-around mb-4 border-top border-bottom py-3">
                            <div class="text-center">
                                <div class="fw-bold h5 mb-0">
                                    <%= typeof userArticleCount !=='undefined' ? userArticleCount : 0 %>
                                </div>
                                <small class="text-muted">文章</small>
                            </div>
                            <div class="text-center">
                                <div class="fw-bold h5 mb-0">
                                    <%= user.followers ? user.followers.length : 0 %>
                                </div>
                                <small class="text-muted">粉丝</small>
                            </div>
                        </div>
                        <div class="d-grid gap-3">
                            <a href="/blog/new" class="btn btn-primary rounded-pill">写下新想法</a>
                            <a href="/profile" class="btn btn-outline-primary rounded-pill">进入空间</a>
                        </div>
                    </div>
                    <% } else { %>
                        <div class="glass-clay p-5 mb-5 text-center bg-white">
                            <i class="fa-solid fa-feather fa-3x text-primary mb-4 opacity-50"></i>
                            <h4 class="mb-3">加入创作之旅</h3>
                                <p class="text-muted small mb-4">记录你的每一个闪光时刻，与志同道合的人相遇。</p>
                                <a href="/login" class="btn btn-primary w-100 rounded-pill mb-3">立即登录</a>
                                <a href="/register" class="btn btn-outline-primary w-100 rounded-pill btn-sm">注册新账号</a>
                        </div>
                        <% } %>

                            <!-- 热门榜单 -->
                            <div class="sidebar-card mb-5">
                                <h5 class="card-header border-0 mb-3">
                                    <i class="fa-solid fa-fire-flame-curved text-primary me-2"></i> 热门辑录
                                </h5>
                                <div class="list-group list-group-flush gap-2">
                                    <% hotBlogs.forEach((blog, index)=> { %>
                                        <a href="/blog/<%= blog._id %>"
                                            class="list-group-item list-group-item-action glass-clay p-3 border-0 transition">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <span class="badge bg-primary rounded-circle"
                                                    style="width:24px; height:24px; font-size:10px;">
                                                    <%= index+1 %>
                                                </span>
                                                <small class="text-muted"><i class="fa-regular fa-eye me-1"></i>
                                                    <%= blog.views %>
                                                </small>
                                            </div>
                                            <h6 class="mb-0 text-truncate">
                                                <%= blog.title %>
                                            </h6>
                                        </a>
                                        <% }) %>
                                </div>
                            </div>

                            <!-- 分类导航 -->
                            <div class="sidebar-card mb-5">
                                <h5 class="card-header border-0 mb-3">
                                    <i class="fa-solid fa-shapes text-primary me-2"></i> 思想分类
                                </h5>
                                <div class="d-flex flex-wrap gap-2">
                                    <a href="/"
                                        class="badge btn-outline-primary rounded-pill p-2 px-3 text-decoration-none <%= typeof currentCategory === 'undefined' || !currentCategory ? 'bg-primary text-white' : 'bg-white' %>">全部</a>
                                    <% if (typeof categories !=='undefined' && categories.length> 0) { %>
                                        <% categories.forEach(category=> { %>
                                            <a href="/?category=<%= category._id %>"
                                                class="badge btn-outline-primary rounded-pill p-2 px-3 text-decoration-none <%= (typeof currentCategory !== 'undefined' && currentCategory == category._id) ? 'bg-primary text-white' : 'bg-white' %>">
                                                <%= category.name %>
                                            </a>
                                            <% }) %>
                                                <% } %>
                                </div>
                            </div>

                            <!-- 极简页脚 -->
                            <div class="text-center small py-4 opacity-50 mt-5">
                                <p>&copy; 2026 听见思想的声音</p>
                            </div>
            </div>
        </div>
    </div>

    <style>
        /* Specific styles for the new index layout */
        .text-truncate-2 {
            display: -webkit-box;
            -webkit-line-clamp: 2;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .text-truncate-3 {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
        }

        .sticky-top-card {
            /* position: sticky; */
            /* Optional: if you want it sticky */
            /* top: 90px; */
        }
    </style>

    <%- include('partials/footer') %>
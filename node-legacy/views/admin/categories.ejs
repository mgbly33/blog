<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>后台管理系统 | 分类管理</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body class="bg-light">

<div class="admin-wrapper">
    <!-- Sidebar -->
    <%- include('partials/sidebar') %>

    <!-- Content -->
    <div class="admin-content">
        <div class="container-fluid animate__animated animate__fadeIn">
            <h2 class="mb-4 text-dark fw-bold">分类管理</h2>

            <div class="row">
                <!-- Create Category Form -->
                <div class="col-md-4 mb-4">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white border-0 py-3">
                            <h5 class="mb-0 fw-bold text-secondary">新建分类</h5>
                        </div>
                        <div class="card-body">
                            <form action="/admin/categories" method="POST">
                                <div class="mb-3">
                                    <label for="name" class="form-label">分类名称</label>
                                    <input type="text" class="form-control" id="name" name="name" required placeholder="例如：技术分享">
                                </div>
                                <div class="mb-3">
                                    <label for="order" class="form-label">排序权重</label>
                                    <input type="number" class="form-control" id="order" name="order" value="0" placeholder="数字越小越靠前">
                                </div>
                                <button type="submit" class="btn btn-primary w-100 rounded-pill">
                                    <i class="fa-solid fa-plus me-2"></i>添加分类
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Category List -->
                <div class="col-md-8">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white border-0 py-3">
                            <h5 class="mb-0 fw-bold text-secondary">分类列表</h5>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4">名称</th>
                                        <th>权重</th>
                                        <th>创建时间</th>
                                        <th>操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% categories.forEach(cat => { %>
                                        <tr>
                                            <form action="/admin/categories/update/<%= cat._id %>" method="POST">
                                                <td class="ps-4">
                                                    <input type="text" class="form-control form-control-sm" name="name" value="<%= cat.name %>" required>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <input type="number" class="form-control form-control-sm me-2" name="order" value="<%= cat.order %>" style="width: 70px;">
                                                        <div class="d-flex flex-column gap-1">
                                                            <button type="submit" formaction="/admin/categories/up/<%= cat._id %>" class="btn btn-outline-secondary btn-sm p-0 d-flex align-items-center justify-content-center" style="width: 20px; height: 20px; font-size: 10px;" title="上移">
                                                                <i class="fa-solid fa-caret-up"></i>
                                                            </button>
                                                            <button type="submit" formaction="/admin/categories/down/<%= cat._id %>" class="btn btn-outline-secondary btn-sm p-0 d-flex align-items-center justify-content-center" style="width: 20px; height: 20px; font-size: 10px;" title="下移">
                                                                <i class="fa-solid fa-caret-down"></i>
                                                            </button>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-secondary"><%= cat.createdAt.toLocaleDateString() %></td>
                                                <td>
                                                    <button type="submit" class="btn btn-outline-primary btn-sm rounded-circle me-1" title="更新">
                                                        <i class="fa-solid fa-check"></i>
                                                    </button>
                                            </form>
                                                    <form action="/admin/categories/delete/<%= cat._id %>" method="POST" class="d-inline">
                                                        <button type="submit" class="btn btn-outline-danger btn-sm rounded-circle" title="删除" onclick="return confirm('确定删除该分类吗？关联的文章将失去分类。')">
                                                            <i class="fa-solid fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </td>
                                        </tr>
                                    <% }) %>
                                    <% if (categories.length === 0) { %>
                                        <tr>
                                            <td colspan="4" class="text-center py-4 text-muted">暂无分类数据</td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
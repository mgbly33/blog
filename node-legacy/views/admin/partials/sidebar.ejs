<div class="admin-sidebar d-flex flex-column">
    <div class="px-4 mb-4">
        <h4 class="fw-bold mb-0 text-white"><i class="fa-solid fa-shield-halved me-2"></i>管理员面板</h4>
        <small class="text-white-50">后台管理系统 v1.0</small>
    </div>

    <ul class="nav flex-column mb-auto">
        <li class="nav-item">
            <a href="/admin" class="nav-link <%= path === '/admin' ? 'active' : '' %>">
                <i class="fa-solid fa-gauge-high"></i> 仪表盘 & 用户
            </a>
        </li>
        <li class="nav-item">
            <a href="/admin/blogs" class="nav-link <%= path === '/admin/blogs' ? 'active' : '' %>">
                <i class="fa-solid fa-file-pen"></i> 博客审核
            </a>
        </li>
        <li class="nav-item">
            <a href="/admin/comments" class="nav-link <%= path === '/admin/comments' ? 'active' : '' %>">
                <i class="fa-solid fa-comments"></i> 评论管理
            </a>
        </li>
        <li class="nav-item">
            <a href="/admin/categories" class="nav-link <%= path === '/admin/categories' ? 'active' : '' %>">
                <i class="fa-solid fa-folder-tree"></i> 分类管理
            </a>
        </li>
        <li class="nav-item">
            <a href="/admin/links" class="nav-link <%= path === '/admin/links' ? 'active' : '' %>">
                <i class="fa-solid fa-link"></i> 友链管理
            </a>
        </li>
    </ul>

    <div class="p-3 border-top border-secondary">
        <div class="dropdown">
            <a href="#" class="d-flex align-items-center text-white text-decoration-none dropdown-toggle" id="dropdownUser1" data-bs-toggle="dropdown" aria-expanded="false">
                <img src="<%= user.avatar || 'https://ui-avatars.com/api/?name=' + user.username + '&background=random' %>" alt="" width="32" height="32" class="rounded-circle me-2">
                <strong><%= user.username %></strong>
            </a>
            <ul class="dropdown-menu dropdown-menu-dark text-small shadow" aria-labelledby="dropdownUser1">
                <li><a class="dropdown-item" href="/">返回前台</a></li>
                <li><a class="dropdown-item" href="/profile">个人设置</a></li>
                <li><hr class="dropdown-divider"></li>
                <li>
                    <form action="/logout" method="POST">
                        <button type="submit" class="dropdown-item">退出登录</button>
                    </form>
                </li>
            </ul>
        </div>
    </div>
</div>

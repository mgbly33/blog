<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>后台管理系统 | 评论详情</title>
    <!-- Bootstrap CSS -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdn.bootcdn.net/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdn.bootcdn.net/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- jQuery -->
    <script src="/js/jquery.min.js"></script>
</head>

<body class="bg-light">

    <div class="admin-wrapper">
        <!-- Sidebar -->
        <%- include('partials/sidebar') %>

            <!-- Content -->
            <div class="admin-content">
                <div class="container-fluid animate__animated animate__fadeIn">
                    <h2 class="mb-4 text-dark fw-bold">评论详情</h2>

                    <div class="mb-4">
                        <a href="/admin/comments" class="btn btn-outline-secondary rounded-pill">
                            <i class="fa-solid fa-arrow-left me-2"></i> 返回文章列表
                        </a>
                    </div>

                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-white border-0 py-3">
                            <h5 class="mb-0 fw-bold text-secondary">
                                <i class="fa-solid fa-comments me-2"></i>
                                <%= blog.title %>
                                    <span class="badge bg-primary rounded-pill ms-2">
                                        <%= comments.length %> 条评论
                                    </span>
                            </h5>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th>作者</th>
                                        <th style="width: 50%;">评论内容</th>
                                        <th>发布时间</th>
                                        <th>操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% comments.forEach(comment=> { %>
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img src="<%= comment.author && comment.author.avatar ? comment.author.avatar : 'https://ui-avatars.com/api/?name=' + (comment.author ? comment.author.username : 'U') + '&background=random' %>"
                                                        class="rounded-circle me-2" width="32" height="32">
                                                    <span class="fw-bold">
                                                        <%= comment.author ? comment.author.username : '未知用户' %>
                                                    </span>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="p-2 bg-light rounded text-secondary small text-break border">
                                                    <%= comment.content %>
                                                </div>
                                            </td>
                                            <td class="text-secondary">
                                                <%= comment.createdAt.toLocaleString() %>
                                            </td>
                                            <td>
                                                <form action="/admin/comment/delete/<%= comment._id %>" method="POST"
                                                    class="d-inline">
                                                    <button type="submit"
                                                        class="btn btn-outline-danger btn-sm rounded-pill"
                                                        onclick="return confirm('确定要删除这条评论吗？')">
                                                        <i class="fa-solid fa-trash me-1"></i> 删除
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% if (comments.length===0) { %>
                                                <tr>
                                                    <td colspan="4" class="text-center text-muted py-5">
                                                        <img src="https://gw.alipayobjects.com/zos/antfincdn/ZHrcdLPrvN/empty.svg"
                                                            alt="No Data" width="80" class="mb-3 opacity-50">
                                                        <p>暂无评论</p>
                                                    </td>
                                                </tr>
                                                <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="/js/bootstrap.bundle.min.js"></script>
</body>

</html>

<!DOCTYPE html>
<html lang="zh-CN">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>后台管理系统 | 博客管理</title>
    <!-- Bootstrap CSS -->
    <link href="/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdn.bootcdn.net/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Animate.css -->
    <link rel="stylesheet" href="https://cdn.bootcdn.net/ajax/libs/animate.css/4.1.1/animate.min.css" />
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <!-- jQuery -->
    <script src="/js/jquery.min.js"></script>
</head>

<body class="bg-light">

    <div class="admin-wrapper">
        <!-- Sidebar -->
        <%- include('partials/sidebar') %>

            <!-- Content -->
            <div class="admin-content">
                <div class="container-fluid animate__animated animate__fadeIn">
                    <h2 class="mb-4 text-dark fw-bold">博客审核与管理</h2>

                    <div class="card shadow-sm border-0">
                        <div
                            class="card-header bg-white border-0 py-3 d-flex justify-content-between align-items-center">
                            <h5 class="mb-0 fw-bold text-secondary"><i class="fa-solid fa-layer-group me-2"></i> 文章列表
                            </h5>
                            <span class="badge bg-primary rounded-pill">
                                <%= blogs.length %> 篇
                            </span>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="bg-light">
                                    <tr>
                                        <th class="ps-4" style="width: 40%;">标题</th>
                                        <th>作者</th>
                                        <th>发布时间</th>
                                        <th>状态</th>
                                        <th>操作</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% blogs.forEach(blog=> { %>
                                        <tr>
                                            <td class="ps-4">
                                                <div>
                                                    <a href="/blog/<%= blog._id %>" target="_blank"
                                                        class="text-decoration-none fw-bold text-dark">
                                                        <%= blog.title %>
                                                    </a>
                                                    <br>
                                                    <small class="text-muted"><i class="fa-regular fa-eye me-1"></i>
                                                        <%= blog.views %> 阅读
                                                    </small>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <img src="<%= blog.author && blog.author.avatar ? blog.author.avatar : 'https://ui-avatars.com/api/?name=' + (blog.author ? blog.author.username : 'U') + '&background=random' %>"
                                                        class="rounded-circle me-2" width="24" height="24">
                                                    <span>
                                                        <%= blog.author ? blog.author.username : '未知用户' %>
                                                    </span>
                                                </div>
                                            </td>
                                            <td class="text-secondary">
                                                <%= blog.createdAt.toLocaleDateString() %>
                                            </td>
                                            <td>
                                                <% if (blog.status === 'pending') { %>
                                                    <span class="badge bg-warning text-dark rounded-pill px-3">待审核</span>
                                                <% } else if (blog.status === 'rejected') { %>
                                                    <span class="badge bg-danger rounded-pill px-3">已拒绝</span>
                                                <% } else { %>
                                                    <span class="badge bg-success rounded-pill px-3">已发布</span>
                                                <% } %>
                                                <br>
                                                <% if (blog.visibility==='private' ) { %>
                                                    <span
                                                        class="badge bg-secondary-subtle text-secondary rounded-pill px-3">私密</span>
                                                    <% } else { %>
                                                        <span
                                                            class="badge bg-success-subtle text-success rounded-pill px-3">公开</span>
                                                        <% } %>
                                                            <% if (blog.isSticky) { %>
                                                                <span
                                                                    class="badge bg-danger-subtle text-danger rounded-pill px-2 ms-1">置顶</span>
                                                                <% } %>
                                            </td>
                                            <td>
                                                <% if (blog.status === 'pending') { %>
                                                    <form action="/admin/blog/approve/<%= blog._id %>" method="POST"
                                                        class="d-inline">
                                                        <button type="submit"
                                                            class="btn btn-outline-success btn-sm rounded-pill"
                                                            title="通过审核"><i class="fa-solid fa-check"></i></button>
                                                    </form>
                                                    <form action="/admin/blog/reject/<%= blog._id %>" method="POST"
                                                        class="d-inline">
                                                        <button type="submit"
                                                            class="btn btn-outline-danger btn-sm rounded-pill"
                                                            title="拒绝发布"
                                                            onclick="return confirm('确定要拒绝这篇文章吗？')"><i class="fa-solid fa-xmark"></i></button>
                                                    </form>
                                                <% } %>
                                                <form action="/admin/blog/toggle-sticky/<%= blog._id %>" method="POST"
                                                    class="d-inline">
                                                    <% if (blog.isSticky) { %>
                                                        <button type="submit"
                                                            class="btn btn-outline-secondary btn-sm rounded-pill"
                                                            title="取消置顶"><i class="fa-solid fa-arrow-down"></i></button>
                                                        <% } else { %>
                                                            <button type="submit"
                                                                class="btn btn-outline-primary btn-sm rounded-pill"
                                                                title="置顶"><i class="fa-solid fa-arrow-up"></i></button>
                                                            <% } %>
                                                </form>
                                                <form action="/admin/blog/delete/<%= blog._id %>" method="POST"
                                                    class="d-inline">
                                                    <button type="submit"
                                                        class="btn btn-outline-danger btn-sm rounded-pill"
                                                        onclick="return confirm('确定要删除这篇文章吗？')">
                                                        <i class="fa-solid fa-trash"></i>
                                                    </button>
                                                </form>
                                            </td>
                                        </tr>
                                        <% }) %>
                                            <% if (blogs.length===0) { %>
                                                <tr>
                                                    <td colspan="5" class="text-center text-muted py-5">暂无文章</td>
                                                </tr>
                                                <% } %>
                                </tbody>
                            </table>
                        </div>
                        <div class="card-footer bg-white border-0 py-3">
                            <!-- Pagination -->
                            <% if (pages> 0) { %>
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-center mb-0">
                                        <% if (current==1) { %>
                                            <li class="page-item disabled"><a
                                                    class="page-link rounded-circle mx-1 border-0 bg-light"><i
                                                        class="fa-solid fa-chevron-left"></i></a></li>
                                            <% } else { %>
                                                <li class="page-item"><a
                                                        class="page-link rounded-circle mx-1 border-0 bg-light"
                                                        href="/admin/blogs?page=1"><i
                                                            class="fa-solid fa-chevron-left"></i></a></li>
                                                <% } %>

                                                    <% var i=(Number(current)> 5 ? Number(current) - 4 : 1) %>
                                                        <% for (; i <=(Number(current) + 4) && i <=pages; i++) { %>
                                                            <% if (i==current) { %>
                                                                <li class="page-item active"><a
                                                                        class="page-link rounded-circle mx-1 border-0">
                                                                        <%= i %>
                                                                    </a></li>
                                                                <% } else { %>
                                                                    <li class="page-item"><a
                                                                            class="page-link rounded-circle mx-1 border-0 bg-light"
                                                                            href="/admin/blogs?page=<%= i %>">
                                                                            <%= i %>
                                                                        </a></li>
                                                                    <% } %>
                                                                        <% } %>

                                                                            <% if (current==pages) { %>
                                                                                <li class="page-item disabled"><a
                                                                                        class="page-link rounded-circle mx-1 border-0 bg-light"><i
                                                                                            class="fa-solid fa-chevron-right"></i></a>
                                                                                </li>
                                                                                <% } else { %>
                                                                                    <li class="page-item"><a
                                                                                            class="page-link rounded-circle mx-1 border-0 bg-light"
                                                                                            href="/admin/blogs?page=<%= pages %>"><i
                                                                                                class="fa-solid fa-chevron-right"></i></a>
                                                                                    </li>
                                                                                    <% } %>
                                    </ul>
                                </nav>
                                <% } %>
                        </div>
                    </div>
                </div>
            </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="/js/bootstrap.bundle.min.js"></script>
</body>

</html>
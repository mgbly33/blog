{
  "name": "blog-project",
  "version": "1.0.0",
  "description": "A simple blog project using Node.js, Express, and MongoDB",
  "main": "dist/app.js",
  "scripts": {
    "start": "node dist/app.js",
    "start:mysql": "node dist/app.sequelize.js",
    "dev": "npx ts-node app.ts",
    "dev:mysql": "npx ts-node app.sequelize.ts",
    "dev:watch": "nodemon",
    "dev:mysql:watch": "nodemon --exec 'npx ts-node app.sequelize.ts'",
    "build": "npm run build:ts && npm run build:assets",
    "build:ts": "tsc",
    "build:assets": "node scripts/build-assets.js",
    "prebuild:ts": "if exist dist rmdir /s /q dist",
    "seed": "ts-node seed.ts",
    "seed:empty": "ts-node seed_empty.ts",
    "seed:keep-blogs": "ts-node seed_keep_blogs.ts",
    "start:demo": "ts-node seed.js && npm start",
    "start:test": "ts-node seed_empty.js && npm start",
    "fix:blogs": "ts-node fix_demo_data.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prepare": "husky",
    "test": "cross-env NODE_ENV=test jest",
    "test:watch": "cross-env NODE_ENV=test jest --watch",
    "test:coverage": "cross-env NODE_ENV=test jest --coverage"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "body-parser": "^1.20.3",
    "cheerio": "^1.1.2",
    "compression": "^1.8.1",
    "connect-redis": "^9.0.0",
    "dotenv": "^17.2.3",
    "easymde": "^2.20.0",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.18.2",
    "form-data": "^4.0.5",
    "helmet": "^8.1.0",
    "highlight.js": "^11.11.1",
    "ioredis": "^5.9.0",
    "jimp": "^1.6.0",
    "jquery": "^3.7.1",
    "marked": "^17.0.1",
    "mongoose": "^8.9.3",
    "multer": "^1.4.5-lts.1",
    "mysql2": "^3.16.3",
    "nodemon": "^3.1.9",
    "sanitize-html": "^2.17.0",
    "sequelize": "^6.37.7",
    "winston": "^3.19.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/body-parser": "^1.19.6",
    "@types/compression": "^1.8.1",
    "@types/connect-redis": "^0.0.23",
    "@types/cors": "^2.8.19",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/express-session": "^1.18.2",
    "@types/jimp": "^0.2.1",
    "@types/jquery": "^3.5.33",
    "@types/marked": "^5.0.2",
    "@types/mongoose": "^5.11.96",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/sanitize-html": "^2.16.0",
    "clean-css": "^5.3.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.2",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-node": "^11.1.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "lint-staged": "^16.2.7",
    "prettier": "^3.7.4",
    "supertest": "^7.2.2",
    "terser": "^5.31.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}

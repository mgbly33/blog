# 应用配置
NODE_ENV=development
PORT=3000

# 数据库配置 (MongoDB - 旧配置)
# MONGODB_URI=mongodb://localhost:27017/blog_db

# 数据库配置 (MySQL - 新配置)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=blog_db
MYSQL_USER=root
MYSQL_PASSWORD=your_password
MYSQL_POOL_SIZE=10

# Session 密钥（生产环境请务必使用复杂的随机字符串）
SESSION_SECRET=your_super_secret_session_key_blog_project

# 文件上传配置
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./public/uploads

# 前端资源 CDN（可选，留空则使用本地资源）
CDN_URL=

# 管理员配置（可选）
ADMIN_EMAIL=
ADMIN_INVITE_CODE=
